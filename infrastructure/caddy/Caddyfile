{
	auto_https off
}

(tls) {
	tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
}

https://localhost:8000 {
	import tls
	reverse_proxy api-gateway:8000
}

# Plain-HTTP entry for local tooling that cannot trust the self-signed cert
# (e.g. containerized browsers). Dev only.
http://localhost:8080, http://:8080 {
	reverse_proxy api-gateway:8000
}

