# Frontend Configuration
NEXT_PUBLIC_APP_NAME=YourApp
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Optional: API Backend (if connecting)
# NOTE: leave this unset in the docker compose stack. The browser derives the
# public gateway (https://<hostname>:8000) from the page host at runtime, and a
# machine-specific value here was what broke account creation before.
NEXT_PUBLIC_API_URL=https://localhost:8000

# Server-side only (no NEXT_PUBLIC_ prefix, so it is never inlined into the
# client bundle). Base URL that /auth-session uses to reach auth-service from
# inside the web container. Defaults to the docker-network address
# http://auth-service:8000, which is correct for deployments/docker-compose.dev.yml.
# Set this only when running `npm run dev` on the host, where the docker DNS name
# does not resolve and the TLS gateway is the reachable address.
# AUTH_SERVICE_URL=https://localhost:8000
